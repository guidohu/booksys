{
  "name": "booking-system",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "serve": "NODE_ENV=development vue-cli-service serve --mode development",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "build-report": "vue-cli-service build --report"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.2",
    "bootstrap": "^5.1.3",
    "bootstrap-icons": "^1.8.1",
    "chart.js": "^2.9.4",
    "chartjs-plugin-colorschemes": "^0.4.0",
    "dayjs": "^1.10.7",
    "js-sha256": "^0.11.0",
    "lodash": "^4.17.21",
    "object-hash": "^3.0.0",
    "raphael": "^2.3.0",
    "register-service-worker": "^1.7.2",
    "sprintf-js": "^1.1.2",
    "vue": "^3.5.16",
    "vue-cli-service": "^5.0.10",
    "vue-loading-overlay": "^6.0.3",
    "vue-recaptcha": "^2.0.3",
    "vue-router": "^4.5.1",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@vue/cli-plugin-pwa": "^5.0.0",
    "@vue/cli-service": "^5.0.8",
    "@vue/eslint-config-prettier": "^9.0.0",
    "eslint": "^8.11.0",
    "eslint-plugin-vue": "^9.21.1",
    "prettier": "^3.2.5"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended",
      "@vue/prettier",
      "plugin:vue/vue3-essential"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "ignorePatterns": [
      "browser.js",
      "**/vendor/*.js"
    ],
    "rules": {
      "vue/no-v-model-argument": "off"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
